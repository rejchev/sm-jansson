import os

builder.SetBuildFolder('libjansson')

rvalue = {}
for cxx in builder.targets:
  binary = Extension.StaticLibrary(builder, cxx, 'jansson')
  
  jansson_root = os.path.join(builder.sourcePath, 'jansson')

  binary.compiler.includes += [
    os.path.join('include'),
    os.path.join('private_include'),
    os.path.join('src'),
  ]

  binary.compiler.defines += ['HAVE_CONFIG_H']

  if binary.compiler.family == 'clang':
    # https://llvm.org/bugs/show_bug.cgi?id=16428
    binary.compiler.cflags += ['-Wno-attributes']

  jansson_src = os.path.join(jansson_root, 'src')
  binary.sources += [
    os.path.join('jansson', 'src', 'dump.c'),
    os.path.join('jansson', 'src', 'error.c'),
    os.path.join('jansson', 'src', 'hashtable.c'),
    os.path.join('jansson', 'src', 'hashtable_seed.c'),
    os.path.join('jansson', 'src', 'load.c'),
    os.path.join('jansson', 'src', 'memory.c'),
    os.path.join('jansson', 'src', 'pack_unpack.c'),
    os.path.join('jansson', 'src', 'strbuffer.c'),
    os.path.join('jansson', 'src', 'strconv.c'),
    os.path.join('jansson', 'src', 'utf.c'),
    os.path.join('jansson', 'src', 'value.c'),
  ]

  rvalue[binary.compiler.target.arch] = builder.Add(binary)